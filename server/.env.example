PORT=4000

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# For an API Key instead, use SK... as TWILIO_API_KEY_SID, its secret as
# TWILIO_API_KEY_SECRET, and the parent AC... Account SID below.
# TWILIO_API_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_FROM_NUMBER=+15017122661
# Or use a Twilio Messaging Service instead of TWILIO_FROM_NUMBER.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS SES SMTP (ap-south-1)
SMTP_ENDPOINT=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your_ses_smtp_username
SMTP_PASSWORD=your_ses_smtp_password
SMTP_FROM_EMAIL=verified-sender@example.com

# SQLite stays on local SSD by default. Override with an absolute path if needed.
# SQLITE_DB_PATH=D:/sms-app-data/sms-app.sqlite
